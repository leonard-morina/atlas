Content-Type: application/json
Idempotency-Key: 8c3f7e4a-2d9b-4e3c-9b5a-4f0d6c8e2a75

{
  "firstName": "Ivo", "lastName": "Eod", "dateOfBirth": "1990-06-15",
  "country": "MA", "nationality": "MKD",
  "identifier": { "type": "NATIONAL_ID", "value": "1506990456660" },
  "email": "ivo@example.com", "phone": "+38970123458",
  "documents": [ { "type": "PASSPORT", "image": "aGVsbG8=" }, { "type": "SELFIE", "image": "aGVsbG8=" } ],
  "termsAccepted": true
}

