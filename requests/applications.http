# Applications API. Start everything with
#   dotnet run --project src/AppHost
# then run any request; no environment needs to be selected.
#
# Requests go through the gateway, the public contract mobile uses. Images are tiny base64 placeholders.
# The Idempotency-Key is fixed per scenario on purpose: change it to submit a new application.

@gateway = http://localhost:5070
@onboarding = http://localhost:5162

### Valid application, MB national ID
POST {{gateway}}/applications
Content-Type: application/json
Idempotency-Key: 6a1f5c2e-0b7d-4c1a-9f3e-2d8b4a6c0e11

{
  "firstName": "Ana",
  "lastName": "Petrova",
  "dateOfBirth": "1991-03-04",
  "country": "MB",
  "nationality": "MKD",
  "identifier": { "type": "NATIONAL_ID", "value": "0403991450014" },
  "email": "ana@example.com",
  "phone": "+38970123456",
  "documents": [
    { "type": "PASSPORT", "image": "aGVsbG8=" },
    { "type": "SELFIE", "image": "aGVsbG8=" }
  ],
  "termsAccepted": true
}

### Valid application, MF resident without a Personal Number (passport)
POST {{gateway}}/applications
Content-Type: application/json
Idempotency-Key: 6a1f5c2e-0b7d-4c1a-9f3e-2d8b4a6c0e12

{
  "firstName": "Omar",
  "lastName": "Haddad",
  "dateOfBirth": "1988-11-20",
  "country": "MF",
  "nationality": "SYR",
  "identifier": { "type": "PASSPORT", "value": "N1234567", "issuingCountry": "SYR" },
  "email": "omar@example.com",
  "phone": "+38970123457",
  "documents": [
    { "type": "PASSPORT", "image": "aGVsbG8=" },
    { "type": "SELFIE", "image": "aGVsbG8=" }
  ],
  "termsAccepted": true
}

### 422: the ticket's sample identifier fails its check digit (CDS-ID-04 §3.1)
POST {{gateway}}/applications
Content-Type: application/json
Idempotency-Key: 6a1f5c2e-0b7d-4c1a-9f3e-2d8b4a6c0e13

{
  "firstName": "Ana",
  "lastName": "Petrova",
  "dateOfBirth": "1991-03-04",
  "country": "MB",
  "nationality": "MKD",
  "identifier": { "type": "NATIONAL_ID", "value": "0403991450016" },
  "email": "ana@example.com",
  "phone": "+38970123456",
  "documents": [
    { "type": "PASSPORT", "image": "aGVsbG8=" },
    { "type": "SELFIE", "image": "aGVsbG8=" }
  ],
  "termsAccepted": true
}

### 422: passport in a market that does not accept one, two selfies, terms not accepted
POST {{gateway}}/applications
Content-Type: application/json
Idempotency-Key: 6a1f5c2e-0b7d-4c1a-9f3e-2d8b4a6c0e14

{
  "firstName": "Ana",
  "lastName": "Petrova",
  "dateOfBirth": "1991-03-04",
  "country": "MB",
  "nationality": "MKD",
  "identifier": { "type": "PASSPORT", "value": "N1234567", "issuingCountry": "MKD" },
  "email": "ana@example.com",
  "phone": "+38970123456",
  "documents": [
    { "type": "SELFIE", "image": "aGVsbG8=" },
    { "type": "SELFIE", "image": "aGVsbG8=" }
  ],
  "termsAccepted": false
}

### 400: Idempotency-Key header missing
POST {{gateway}}/applications
Content-Type: application/json

{
  "firstName": "Ana"
}

### Directly against the service (bypasses the gateway; versioned path)
POST {{onboarding}}/v1/applications
Content-Type: application/json
Idempotency-Key: 6a1f5c2e-0b7d-4c1a-9f3e-2d8b4a6c0e11

{
  "firstName": "Ana",
  "lastName": "Petrova",
  "dateOfBirth": "1991-03-04",
  "country": "MB",
  "nationality": "MKD",
  "identifier": { "type": "NATIONAL_ID", "value": "0403991450014" },
  "email": "ana@example.com",
  "phone": "+38970123456",
  "documents": [
    { "type": "PASSPORT", "image": "aGVsbG8=" },
    { "type": "SELFIE", "image": "aGVsbG8=" }
  ],
  "termsAccepted": true
}

### 404: versioned paths are not exposed by the gateway
POST {{gateway}}/v1/applications
Content-Type: application/json
Idempotency-Key: 6a1f5c2e-0b7d-4c1a-9f3e-2d8b4a6c0e11

{}
