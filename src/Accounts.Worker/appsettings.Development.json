{
  // Shorter waits so the scenarios in requests/atlas.http finish in a minute or two. They keep the same order as in
  // production: the stand-in's slow call outlives the timeout, and its replica lags behind the first lookup.
  "Accounts": {
    "Opening": {
      "OpenAccountTimeout": "00:00:20",
      "LookupTimeout": "00:00:10",
      "LeaseMargin": "00:00:15",
      "ConfirmationDelay": "00:00:15",
      "BusyRetryDelay": "00:00:05"
    }
  }
}
