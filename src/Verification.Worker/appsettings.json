{
  "Logging": {
    // Framework logs that repeat what a trace span already records (with timings) are kept at Warning;
    // errors and retries still come through. Override per category when debugging, e.g.
    // Logging__LogLevel__Polly=Information.
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning", // the SQL span
      "Azure": "Warning", // the Blob Storage span
      "System.Net.Http.HttpClient": "Warning", // the provider call span
      "Polly": "Warning" // the provider call span; retries are still logged as warnings
    }
  },
  "AllowedHosts": "*",
  // The external providers. Locally the stand-ins in src/Stubs, found by service discovery as "stubs";
  // in production the providers' real API roots.
  "Providers": {
    "IdNow": { "BaseUrl": "http://stubs/idnow/", "Timeout": "00:00:30" },
    "WorldCheck": { "BaseUrl": "http://stubs/worldcheck/", "Timeout": "00:00:30" }
  }
}
