{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Annex B to GC-2026-0814. A market not listed here is not supported; adding one requires
  // Annex B to be reissued first (note 3).
  "Markets": {
    "MA": { "IdentifierScheme": "PersonalNumber", "Activation": "Remote" },
    "MB": { "IdentifierScheme": "PersonalNumber", "Activation": "Remote" },
    "MC": { "IdentifierScheme": "UnifiedCitizenId", "Activation": "Remote" },
    "MD": { "IdentifierScheme": "CitizenNumber", "Activation": "InBranch" },
    "ME": { "IdentifierScheme": "CivilNumber", "Activation": "Remote" },
    "MF": { "IdentifierScheme": "PersonalNumber", "AcceptsPassport": true, "Activation": "Remote" }
  }
}
