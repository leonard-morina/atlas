{
  "Logging": {
    // Framework logs that repeat what a trace span already records (with timings) are kept at Warning;
    // errors and retries still come through. Override per category when debugging, e.g.
    // Logging__LogLevel__Polly=Information.
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning", // the SQL span
      "Azure": "Warning" // the Blob Storage span
    }
  },
  "AllowedHosts": "*",
  // A submission waits this long for verification to decide before answering 202 PROCESSING.
  "Onboarding": {
    "DecisionWait": { "Budget": "00:00:10" }
  },
  // Annex B to GC-2026-0814. A market not listed here is not supported; adding one requires
  // Annex B to be reissued first (note 3).
  "Markets": {
    "MA": { "IdentifierScheme": "PersonalNumber", "Activation": "Remote" },
    "MB": { "IdentifierScheme": "PersonalNumber", "Activation": "Remote" },
    "MC": { "IdentifierScheme": "UnifiedCitizenId", "Activation": "Remote" },
    "MD": { "IdentifierScheme": "CitizenNumber", "Activation": "InBranch" },
    "ME": { "IdentifierScheme": "CivilNumber", "Activation": "Remote" },
    "MF": { "IdentifierScheme": "PersonalNumber", "AcceptsPassport": true, "Activation": "Remote" }
  }
}
