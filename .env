# Local development only — single source of truth for the local infrastructure.
#
# Committed on purpose: these are throwaway values for the local Docker containers
# (the SQL password is the one from the provided platform compose file), so the
# solution runs with no manual setup step. Real secrets never live here; in Azure
# they come from Key Vault.
#
# Port already taken (e.g. a local SQL Server on 1433)? Change it here once —
# Docker Compose and the .NET services both read this file.

# SQL Server
SQL_PORT=1433
SQL_PASSWORD=Local_Dev_Password_1

# Seq (logs) — UI and ingestion on the same port
SEQ_PORT=5341

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=atlas
RABBITMQ_PASSWORD=atlas_local_dev

# Azurite (blob storage for documents)
AZURITE_BLOB_PORT=10000

# Redis (rate limiting at the gateway)
REDIS_PORT=6379
